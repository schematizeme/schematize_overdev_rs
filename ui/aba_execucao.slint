import { ScrollView } from "std-widgets.slint";
import { Th, Btn } from "tema.slint";
import { Ov } from "estado.slint";

// Aba EXECUÇÃO: controles do run, coluna Sistema, split multiagent e o monitor.
//
// Tudo que SPAWNA o `claude` (Executar, Dividir, Dividir+lançar) abre o TERMINAL — a linha de
// comando aparece antes de rodar (D6). Só «Parar» é comando rápido na própria janela.

// Um par valor/rótulo da coluna Sistema.
component Metrica inherits VerticalLayout {
    in property <string> rotulo;
    in property <string> valor;
    in property <color> cor: Th.text;
    spacing: 1px;
    Text { text: valor; font-size: 20px; font-weight: 800; color: cor; horizontal-alignment: center; }
    Text { text: rotulo; font-size: 11px; color: Th.text-dim; horizontal-alignment: center; }
}

export component AbaExecucao inherits ScrollView {
    VerticalLayout {
        alignment: start;
        spacing: 10px;

        // ---- controles do run ----
        Rectangle {
            border-radius: 12px;
            border-width: 1px;
            border-color: Th.border;
            background: Th.surface;
            height: ctl.preferred-height;
            ctl := VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text { text: "Controles do run"; font-size: 13.5px; font-weight: 800; color: Th.text; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Btn { label: "Executar"; primary: true; small: true; enabled: Ov.tem-run && !Ov.exec-confirmar; clicked => { Ov.executar-pedir(); } }
                    Btn { label: "Parar"; small: true; enabled: Ov.tem-run; clicked => { Ov.parar(); } }
                    Btn { label: Ov.acompanhando ? "Acompanhando…" : "Reload / Acompanhar"; small: true; primary: Ov.acompanhando; enabled: Ov.tem-run; clicked => { Ov.acompanhar(); } }
                    Btn { label: "Atualizar tokens"; small: true; clicked => { Ov.atualizar-tokens(); } }
                }
                if !Ov.tem-run: Text {
                    text: "Sem run neste diretório. Inicie com `schematize-overdev start \"<objetivo>\"`.";
                    font-size: 12px; color: Th.text-dim; wrap: word-wrap;
                }
                // Guardrail: o comando que o terminal vai rodar, e só roda se confirmar.
                if Ov.exec-confirmar: Rectangle {
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: Th.warn;
                    background: Th.bg;
                    height: gr.preferred-height;
                    gr := VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text {
                            text: "O agente `claude` vai mexer neste projeto. Abre num TERMINAL, com este comando:";
                            font-size: 12px; font-weight: 600; color: Th.warn; wrap: word-wrap;
                        }
                        Text { text: Ov.exec-cmd; font-size: 11.5px; color: Th.text; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            Btn { label: "Cancelar"; small: true; clicked => { Ov.executar-cancelar(); } }
                            Btn { label: "Abrir no terminal"; small: true; primary: true; clicked => { Ov.executar-confirmar(); } }
                        }
                    }
                }
                if Ov.exec-status != "": Text {
                    text: Ov.exec-status;
                    font-size: 12px; font-weight: 600;
                    color: Ov.exec-erro ? Th.warn : Th.good;
                    wrap: word-wrap;
                }
            }
        }

        // ---- Sistema + split ----
        HorizontalLayout {
            spacing: 10px;
            alignment: stretch;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 12px;
                border-width: 1px;
                border-color: Th.border;
                background: Th.surface;
                height: sis.preferred-height;
                sis := VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        Text { text: "Sistema"; font-size: 13.5px; font-weight: 800; color: Th.text; vertical-alignment: center; }
                        Rectangle {}
                        Btn { label: "Rechecar"; small: true; clicked => { Ov.rechecar(); } }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        Metrica { rotulo: "teto"; valor: Ov.sis-teto; }
                        Metrica { rotulo: "livre"; valor: Ov.sis-livre; cor: Ov.sis-livre > 0 ? Th.good : Th.warn; }
                        Metrica { rotulo: "rodando"; valor: Ov.sis-rodando; }
                        Metrica { rotulo: "load"; valor: Ov.sis-load; }
                    }
                    if Ov.sis-erro != "": Text { text: Ov.sis-erro; font-size: 11.5px; color: Th.warn; wrap: word-wrap; }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 12px;
                border-width: 1px;
                border-color: Th.border;
                background: Th.surface;
                height: spl.preferred-height;
                spl := VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text { text: "Dividir em N claudes (multiagent)"; font-size: 13.5px; font-weight: 800; color: Th.text; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Btn { label: "−"; small: true; clicked => { Ov.split-mudar(-1); } }
                        Text { text: Ov.split-k; font-size: 16px; font-weight: 800; color: Th.text; vertical-alignment: center; min-width: 28px; horizontal-alignment: center; }
                        Btn { label: "+"; small: true; clicked => { Ov.split-mudar(1); } }
                        Btn { label: "Dividir"; small: true; enabled: Ov.tem-run; clicked => { Ov.dividir(false); } }
                        Btn { label: "Dividir + lançar"; small: true; primary: true; enabled: Ov.tem-run; clicked => { Ov.dividir(true); } }
                    }
                    if Ov.split-plano != "": Text { text: Ov.split-plano; font-size: 11.5px; color: Th.text-dim; wrap: word-wrap; }
                    if Ov.split-status != "": Text {
                        text: Ov.split-status;
                        font-size: 11.5px; font-weight: 600;
                        color: Ov.split-erro ? Th.warn : Th.good;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // ---- monitor ----
        Rectangle {
            border-radius: 12px;
            border-width: 1px;
            border-color: Th.border;
            background: Th.surface;
            height: mon.preferred-height;
            mon := VerticalLayout {
                padding: 12px;
                spacing: 6px;
                Text { text: "Monitor"; font-size: 13.5px; font-weight: 800; color: Th.text; }
                Text {
                    text: Ov.tokens-linha != "" ? Ov.tokens-linha : "Tokens: — (clique em «Atualizar tokens»)";
                    font-size: 12px; color: Th.text-dim; wrap: word-wrap;
                }
                Text { text: "Próximos itens abertos"; font-size: 12px; font-weight: 700; color: Th.text; }
                if Ov.mon-abertos.length == 0: Text { text: "nenhum item de máquina aberto"; font-size: 11.5px; color: Th.text-dim; }
                for a in Ov.mon-abertos: Text { text: "○ " + a; font-size: 12px; color: Th.text; wrap: word-wrap; }
                Text { text: "Concluídos (mais recentes)"; font-size: 12px; font-weight: 700; color: Th.text; }
                if Ov.mon-conclusoes.length == 0: Text { text: "nenhuma conclusão registrada"; font-size: 11.5px; color: Th.text-dim; }
                for c in Ov.mon-conclusoes: Text { text: "✓ " + c; font-size: 12px; color: Th.good; wrap: word-wrap; }
            }
        }
    }
}
