// As structs que cruzam a fronteira Rust -> Slint.

export struct QuizOpcaoUI {
    id: string,
    rotulo: string,
    detalhe: string,
    sugerida: bool,
    marcada: bool,
}

export struct QuizUI {
    id: string,
    titulo: string,
    contexto: string,
    // O SLUG do kind (`escolha`, `aprovar`, `multipla`, `sim_nao_outro`, `livre`): cada um
    // desenha um controle diferente, e a forma da pergunta na tela É a guarda.
    kind: string,
    destrava: string,
    aberta: bool,
    aguarda-revisao: bool,
    resposta-texto: string,
    respondida-em: string,
    revisao: string,
    opcoes: [QuizOpcaoUI],
}

export struct ItemUI {
    tipo: string,
    texto: string,
    maquina: bool,
    sub: bool,
    // Posição entre os humanos ABERTOS (1-based) — o argumento de `human --done`/`answer`/`refuse`.
    humano-n: int,
}

export struct SnapUI {
    id: int,
    arquivo: string,
    quando: string,
    tamanho: string,
}

// Uma demanda da caixa de entrada: o texto cru e, se já organizada, os itens que viraram.
export struct CaixaUI {
    id: string,
    texto: string,
    itens: string,
}

// Um documento editável do run (PLAN.md, CHECKLIST.md, NOTAS.md).
export struct ArquivoUI {
    nome: string,
    caminho: string,
    existe: bool,
}
