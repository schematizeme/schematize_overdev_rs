import { ScrollView, TextEdit } from "std-widgets.slint";
import { Th, Btn } from "tema.slint";
import { Ov } from "estado.slint";

// Aba CAIXA DE ENTRADA: jogar «isso também precisa» no projeto ENQUANTO um agente trabalha, sem
// tocar no checklist. Capturar e fundir são comandos do CLI; organizar abre um agente num terminal.
export component AbaCaixa inherits ScrollView {
    VerticalLayout {
        alignment: start;
        spacing: 10px;
        Text {
            text: "Captura uma demanda sem interromper o agente: o checklist só muda quando você funde.";
            font-size: 12px; color: Th.text-dim; wrap: word-wrap;
        }
        Rectangle {
            height: 92px;
            border-radius: 8px;
            border-width: 1px;
            border-color: Th.border;
            background: Th.bg;
            TextEdit {
                width: parent.width - 4px;
                height: parent.height - 4px;
                x: 2px;
                y: 2px;
                text <=> Ov.caixa-texto;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Btn { label: "Capturar"; small: true; primary: true; enabled: Ov.caixa-texto != ""; clicked => { Ov.caixa-adicionar(); } }
            Btn { label: "Organizar com agente (" + Ov.caixa-pendentes.length + ")"; small: true; enabled: Ov.caixa-pendentes.length > 0; clicked => { Ov.caixa-agente(); } }
            Btn { label: "Fundir no checklist (" + Ov.caixa-prontas.length + ")"; small: true; enabled: Ov.caixa-prontas.length > 0; clicked => { Ov.caixa-mesclar(); } }
        }
        if Ov.caixa-status != "": Text {
            text: Ov.caixa-status;
            font-size: 12px; font-weight: 600;
            color: Ov.caixa-erro ? Th.warn : Th.good;
            wrap: word-wrap;
        }
        Text { text: "A organizar (" + Ov.caixa-pendentes.length + ")"; font-size: 13px; font-weight: 800; color: Th.text; }
        if Ov.caixa-pendentes.length == 0: Text { text: "nenhuma demanda esperando."; font-size: 12px; color: Th.text-dim; }
        for d in Ov.caixa-pendentes: Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: Th.border;
            background: Th.surface;
            height: tp.preferred-height;
            tp := VerticalLayout {
                padding: 8px;
                spacing: 2px;
                Text { text: d.texto; font-size: 12.5px; color: Th.text; wrap: word-wrap; }
                Text { text: d.id; font-size: 10.5px; color: Th.text-dim; }
            }
        }
        Text { text: "A fundir (" + Ov.caixa-prontas.length + ")"; font-size: 13px; font-weight: 800; color: Th.text; }
        if Ov.caixa-prontas.length == 0: Text { text: "nada organizado ainda."; font-size: 12px; color: Th.text-dim; }
        for d in Ov.caixa-prontas: Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: Th.accent;
            background: Th.surface;
            height: tq.preferred-height;
            tq := VerticalLayout {
                padding: 8px;
                spacing: 2px;
                Text { text: d.itens; font-size: 12.5px; color: Th.text; wrap: word-wrap; }
                Text { text: d.id; font-size: 10.5px; color: Th.text-dim; }
            }
        }
    }
}
